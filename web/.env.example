# Copy to .env.local (gitignored) and fill in. Both values are safe to ship to
# the browser: access is enforced by Row Level Security, not by these values.
# Never put the service_role / secret key or the database password here.

# Supabase dashboard -> Project Settings -> API (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Same page: the PUBLISHABLE key (starts with sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
