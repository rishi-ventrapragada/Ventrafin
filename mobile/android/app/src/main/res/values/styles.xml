<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light mode only (PRD 4.8). Both themes extend AppCompat because local_auth's
         BiometricPrompt can crash on Android 8 and below with a non-AppCompat theme. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Shown while the Flutter engine starts; removed on the first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
